# Copy to .env and fill in. .env is git-ignored: never commit real values.
#
# None of these are needed for local bot play. The server and online rooms run
# without them; sign-in and the database need the values marked below.

# --- Server ---------------------------------------------------------------
PORT=3000

# MySQL / TiDB connection string, e.g. mysql://user:password@host:4000/dbname
# Optional: without it the server runs with no database.
DATABASE_URL=

# Random string used to sign session cookies. Required for sign-in.
JWT_SECRET=

# Manus OAuth (sign-in). Required for sign-in only.
VITE_APP_ID=
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im
OWNER_OPEN_ID=
OWNER_NAME=

# Manus Forge APIs (LLM, image generation, storage). Optional.
BUILT_IN_FORGE_API_URL=https://forge.manus.ai
BUILT_IN_FORGE_API_KEY=

# --- App (read at bundle time) ---------------------------------------------
# Where the app reaches the server. Leave empty on web to derive it from the
# page address; set it for phones, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_BASE_URL=
